#usda 1.0

over "demo_datacentre_01"
{
    over "_TypeCatalog"
    {
        class "OfficeBuildUp_PlasterboardPartition" (
            prepend apiSchemas = ["AecoBuildUpAPI"]
            displayName = "Plasterboard partition — 150 mm"
            prepend inherits = </demo_datacentre_01/_TypeCatalog/Internal_Wall_150>
        )
        {
            token[] aeco:buildUp:functions = ["finish", "structure", "finish"]
            string[] aeco:buildUp:materials = ["Plasterboard", "Metal stud and insulation zone", "Plasterboard"]
            int[] aeco:buildUp:priorities = [10, 50, 10]
            double[] aeco:buildUp:thicknesses = [0.025, 0.1, 0.025]
        }

        class "OfficeBuildUp_Blockwork" (
            prepend apiSchemas = ["AecoBuildUpAPI"]
            displayName = "Finished blockwork — 200 mm"
            prepend inherits = </demo_datacentre_01/_TypeCatalog/Fire_Wall_200>
        )
        {
            token[] aeco:buildUp:functions = ["finish", "structure", "finish"]
            string[] aeco:buildUp:materials = ["Plaster", "Dense concrete blockwork", "Plaster"]
            int[] aeco:buildUp:priorities = [10, 50, 10]
            double[] aeco:buildUp:thicknesses = [0.015, 0.17, 0.015]
        }

        class "OfficeBuildUp_WcLining" (
            prepend apiSchemas = ["AecoBuildUpAPI"]
            displayName = "WC lined partition — 150 mm"
            prepend inherits = </demo_datacentre_01/_TypeCatalog/Internal_Wall_150>
        )
        {
            token[] aeco:buildUp:functions = ["finish", "structure", "substrate", "finish"]
            string[] aeco:buildUp:materials = ["Plasterboard", "Metal stud and insulation zone", "Moisture-resistant board", "Tile finish"]
            int[] aeco:buildUp:priorities = [10, 50, 20, 10]
            double[] aeco:buildUp:thicknesses = [0.025, 0.1, 0.015, 0.01]
        }
    }

    over "demo_datacentre_01_Site"
    {
        over "demo_datacentre_01"
        {
            over "L00_Ground"
            {
                over "wall_l0_h_004" (
                    inherits = </demo_datacentre_01/_TypeCatalog/OfficeBuildUp_PlasterboardPartition>
                )
                {
                }

                over "wall_l0_h_005" (
                    inherits = </demo_datacentre_01/_TypeCatalog/OfficeBuildUp_PlasterboardPartition>
                )
                {
                }

                over "wall_l0_h_006" (
