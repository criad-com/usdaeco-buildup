#usda 1.0
(
    defaultPrim = "Example"
    metersPerUnit = 1
    upAxis = "Z"
)
class "_TypeCatalog" {
    class "LayeredSection" (
        prepend apiSchemas = ["AecoTypeAPI", "AecoBuildUpAPI"]
    ) {
        double[] aeco:buildUp:thicknesses = [0.02, 0.16, 0.02]
        token[] aeco:buildUp:functions = ["finish", "structure", "finish"]
        string[] aeco:buildUp:materials = ["Plaster", "Masonry", "Plaster"]
        int[] aeco:buildUp:priorities = [10, 50, 10]
    }
}
def Xform "Example" (
    prepend inherits = </_TypeCatalog/LayeredSection>
) {}
